# Gemini API Key for every AI feature (solver, verifier, OCR, translation, embeddings)
# Free key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Optional per-role model overrides (defaults are set in code)
GEMINI_SOLVER_MODEL=
GEMINI_SOLVER_FALLBACK_MODEL=
GEMINI_VERIFY_MODEL=
GEMINI_OCR_MODEL=
GEMINI_OCR_FALLBACK_MODEL=

# Existing server settings (configure secrets on Vercel; do not commit actual values)
MONGODB_URI=
JWT_SECRET=
# Two-stage retrieval (Gemini embeddings, no OpenAI key required)
RAG_MODE=hybrid
RAG_EMBEDDING_MODEL=gemini-embedding-001
RAG_EMBEDDING_DIMENSIONS=1536
RAG_MIN_TAG_OVERLAP=0.25
# Fill with an actual paid embedding price only if billing is enabled; blank = free tier (0)
RAG_EMBEDDING_USD_PER_MILLION=
# Protect the daily indexing worker; a long random secret
CRON_SECRET=
